{
  "name": "skillmirror-ai",
  "version": "2.4.0",
  "description": "SkillMirror AI — Full-Stack AI Talent Discovery, Skill Assessment, Proof-of-Work, and Opportunity Matching Platform.",
  "scripts": {
    "start": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
