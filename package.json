    "build:frontend": "cd client && npm run build",
    "test": "python -m unittest tests/test_engine.py"
  },
  "keywords": [
    "skillmirror-ai",
    "talent-discovery",
    "proof-of-work",
    "ghost-sprint",
    "thought-x-ray",
    "deterministic-signals",
    "fastapi",
    "react",
    "recharts"
  ],
